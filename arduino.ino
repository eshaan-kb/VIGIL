// ================================================
// RESOURCE DETAILS
// ================================================

void drawResourceDetails() {
  drawHeader(resourceName(selectedResource));

  u8g2.setFont(u8g2_font_5x8_tf);

  float currentPrice = currentPrices[selectedResource];
  float previousPrice = previousPrices[selectedResource];
  float changePercent = (previousPrice != 0)
    ? ((currentPrice - previousPrice) / previousPrice) * 100.0 : 0;

  drawLocalizedText(2, 24, currentLabel());
  u8g2.setCursor(84, 24);
  u8g2.print(currentPrice, 2);
  u8g2.print(priceUnits[selectedResource]);

  drawLocalizedText(2, 34, beforeLabel());
  u8g2.setCursor(84, 34);
  if (previousPrice > 0) {
    u8g2.print(previousPrice, 2);
    u8g2.print(priceUnits[selectedResource]);
  } else {
    u8g2.print("N/A");
  }

  drawLocalizedText(2, 44, changeLabel());
  u8g2.setCursor(84, 44);
  if (previousPrice > 0) {
    u8g2.print(changePercent, 2);
    u8g2.print("%");
  } else {
    u8g2.print("N/A");
  }

  drawLocalizedText(2, 54, impactLabel());
  drawLocalizedText(2, 62, impactEvent.c_str());

  drawLocalizedText(100, 11, backLabel());
}

