// ================================================
// MENU LENGTH
// ================================================

int menuLength() {
  switch (screen) {
    case HOME:
      return 3;

    case RESOURCES:
      return RESOURCE_COUNT + 1;

    case LANGUAGES:
      return LANGUAGE_COUNT + 1;

    case HISTORY:
      return 3;

    default:
      return 1;
  }
}

// ================================================
// MENU TEXT
// ================================================

const char* menuText(int index) {
  switch (screen) {
    case HOME:
      return homeItem(index);

    case RESOURCES:
      if (index < RESOURCE_COUNT)
        return resourceName(index);
      return backLabel();

    case LANGUAGES:
      if (index < LANGUAGE_COUNT)
        return languageName(index);
      return backLabel();

    case HISTORY:
      if (index == 0)
        return pastLabel();

      if (index == 1)
        return clearLabel();

      return backLabel();

    default:
      return "";
  }
}

// ================================================
// HEADER
// ================================================

void drawHeader(const char* title) {
  u8g2.setFont(u8g2_font_6x12_tf);
  drawLocalizedText(2, 14, title);
  u8g2.drawHLine(0, 17, 128);
}

// ================================================
// MENU DRAWING
// ================================================

void drawMenuList() {
  const int visibleRows = 3;
  const int total = menuLength();

  int start = 0;

  if (total > visibleRows) {
    start = selection - 1;

    if (start < 0)
      start = 0;

    if (start > total - visibleRows)
      start = total - visibleRows;
  }

  for (int row = 0; row < visibleRows; row++) {
    int item = start + row;

    if (item >= total)
      break;

    int y = 26 + row * 16;

    if (item == selection) {
      int highlightOffset = (language == ENGLISH) ? 0 : 6;
      u8g2.drawBox(0, y - 14 + highlightOffset, 128, 15);
      u8g2.setDrawColor(0);
      drawLocalizedText(3, y, menuText(item));
      u8g2.setDrawColor(1);
    }
    else {
      drawLocalizedText(3, y, menuText(item));
    }
  }
}

