// ================================================
// ALERT
// ================================================

void drawAlert() {
  // High-contrast alert banner and bold alert text.
  u8g2.setFont(u8g2_font_6x13B_tf);
  u8g2.drawBox(0, 0, 128, 16);
  u8g2.setDrawColor(0);
  u8g2.drawStr(3, 12, "AGRICLOUD ALERT");
  u8g2.setDrawColor(1);

  u8g2.setFont(u8g2_font_6x13B_tf);
  u8g2.drawStr(2, 30, alertHeading.c_str());
  u8g2.setFont(u8g2_font_5x8_tf);
  // Simulate bold with a one-pixel overdraw; 5x8B is not
  // included in every U8g2 font build.
  u8g2.drawStr(2, 43, alertMessage.c_str());
  u8g2.drawStr(3, 43, alertMessage.c_str());
  u8g2.setFont(u8g2_font_5x8_tf);
  u8g2.drawStr(2, 61, "Press button to dismiss");
}

// ================================================
// RENDER
// ================================================

void render() {
  u8g2.firstPage();

  do {
    if (alertActive) {
      drawAlert();
    }
    else {
      switch (screen) {
        case HOME:            drawHome();            break;
        case RESOURCES:       drawResources();       break;
        case LANGUAGES:       drawLanguages();      break;
        case HISTORY:         drawHistory();        break;
        case RESOURCE_DETAILS: drawResourceDetails(); break;
        case HISTORY_VIEW:    drawHistoryView();    break;
        case ALERT_PAGE:      drawAlert();          break;
      }
    }
  } while (u8g2.nextPage());
}

// ================================================
// NAVIGATION
// ================================================

void readNavigation() {
  if (alertActive)
    return;

  if (screen == RESOURCE_DETAILS || screen == HISTORY_VIEW)
    return;

  int raw = analogRead(NAV_PIN);

  if (!navigationInitialized) {
    filteredValue = raw;
    navigationInitialized = true;
  }

  filteredValue = (filteredValue * 3 + raw) / 4;

  int total = menuLength();

  if (total <= 1)
    return;

  int newSelection = ((long)filteredValue * total) / 1024;
  newSelection = constrain(newSelection, 0, total - 1);

  if (newSelection != selection) {
    if (newSelection != candidateSelection) {
      candidateSelection = newSelection;
      candidateStartTime = millis();
    }

    if (millis() - candidateStartTime >= NAV_STABILITY_TIME) {
      selection = candidateSelection;
      candidateSelection = -1;
      render();
    }
  }
  else {
    candidateSelection = -1;
  }
}

// ================================================
// CHANGE LANGUAGE
// ================================================

void setLanguage(Language newLanguage) {
  language = newLanguage;
  screen = LANGUAGES;  // stay on language selection menu
  candidateSelection = -1;
  render();
}

// ================================================
// BUTTON ACTION
// ================================================

void buttonAction() {
  if (alertActive) {
    alertActive = false;
    noTone(BUZZER_PIN);
    screen = HOME;
    selection = 0;
    candidateSelection = -1;
    render();
    return;
  }

  switch (screen) {
    case HOME:
      if (selection == 0) {
        screen = RESOURCES;
        selection = 0;
      }
      else if (selection == 1) {
        screen = LANGUAGES;
        selection = 0;
      }
      else {
        screen = HISTORY;
        selection = 0;
      }
      break;

    case RESOURCES:
      if (selection == RESOURCE_COUNT) {
        screen = HOME;
        selection = 0;
      }
      else {
        selectedResource = selection;
        screen = RESOURCE_DETAILS;
      }
      break;

    case LANGUAGES:
      if (selection == 0) {
        setLanguage(ENGLISH);
        return;
      }
      else if (selection == 1) {
        setLanguage(HINDI);
        return;
      }
      else if (selection == 2) {
        setLanguage(KANNADA);
        return;
      }
      else {
        screen = HOME;
        selection = 0;
      }
      break;

    case HISTORY:
      if (selection == 0) {
        screen = HISTORY_VIEW;
      }
      else if (selection == 1) {
        historyMessage = "History cleared";
        screen = HISTORY;
        selection = 0;
      }
      else {
        screen = HOME;
        selection = 0;
      }
      break;

    case RESOURCE_DETAILS:
      screen = RESOURCES;
      selection = selectedResource;
      break;

    case HISTORY_VIEW:
      screen = HISTORY;
      selection = 0;
      break;

    default:
      screen = HOME;
      selection = 0;
      break;
  }

  candidateSelection = -1;
  render();
}

// ================================================
// BUTTON DEBOUNCE
// ================================================

void readButton() {
  bool reading = digitalRead(BUTTON_PIN);

  if (reading != lastButtonReading)
    lastDebounceTime = millis();

  if (millis() - lastDebounceTime > DEBOUNCE_DELAY) {
    if (reading != stableButtonState) {
      stableButtonState = reading;

      if (stableButtonState == LOW)
        buttonAction();
    }
  }

  lastButtonReading = reading;
}

// ================================================
// COMMAND HANDLING (USB SERIAL + BLUETOOTH LE)
// ================================================

void processCommand(String cmd) {
  cmd.trim();
  if (cmd.length() == 0) return;

  if (cmd == "ALERT:MAJOR") {
    alertHeading = "MAJOR IMPACT";
    alertMessage = "Agricultural impact detected";
    alertActive = true;
    tone(BUZZER_PIN, 2200);
    screen = ALERT_PAGE;
    render();
  }
  else if (cmd == "ALERT:CLEAR") {
    alertActive = false;
    noTone(BUZZER_PIN);
    screen = HOME;
    selection = 0;
    render();
  }
  else if (cmd.startsWith("PRICE:")) {
    String data = cmd.substring(6);
    int p1 = data.indexOf(':');
    int p2 = data.indexOf(':', p1 + 1);
    if (p1 > 0 && p2 > p1) {
      currentPrices[selectedResource] = data.substring(0, p1).toFloat();
      previousPrices[selectedResource] = data.substring(p1 + 1, p2).toFloat();
      render();
    }
  }
  else if (cmd.startsWith("EVENT:")) {
    impactEvent = cmd.substring(6);
    render();
  }
  else if (cmd.startsWith("HISTORY:")) {
    historyMessage = cmd.substring(8);
    render();
  }
}

void processSerial() {
  if (!Serial.available()) return;
  String cmd = Serial.readStringUntil('\n');
  processCommand(cmd);
}

void processBluetooth() {
  if (!bleReady) return;
  BLE.poll();
  if (vigilCharacteristic.written()) {
    char message[181];
    int length = vigilCharacteristic.readValue((uint8_t*)message, 180);
    if (length < 0) length = 0;
    if (length > 180) length = 180;
    message[length] = '\0';
    String cmd = String(message);
    processCommand(cmd);
  }
}

// ================================================
// SETUP
// ================================================

void setup() {
  Serial.begin(115200);

  pinMode(NAV_PIN, INPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);

  u8g2.begin();
  u8g2.setFontMode(1);
  u8g2.setDrawColor(1);

  // Start BLE peripheral. The LCD/menu remains usable if BLE startup fails.
  if (BLE.begin()) {
    BLE.setLocalName(DEVICE_NAME);
    BLE.setDeviceName(DEVICE_NAME);
    BLE.setAdvertisedService(vigilService);
    vigilService.addCharacteristic(vigilCharacteristic);
    BLE.addService(vigilService);
    vigilCharacteristic.writeValue("READY");
    BLE.advertise();
    bleReady = true;
    Serial.println("VIGIL BLE advertising");
  } else {
    bleReady = false;
    Serial.println("BLE failed to start; USB Serial remains available");
  }

  filteredValue = analogRead(NAV_PIN);
  navigationInitialized = true;

  screen = HOME;
  selection = 0;

  render();
}

// ================================================
// LOOP
// ================================================

void loop() {
  readNavigation();
  readButton();
  processSerial();
  processBluetooth();

  if (alertActive && screen != ALERT_PAGE) {
    screen = ALERT_PAGE;
    render();
  }

  delay(5);
}
