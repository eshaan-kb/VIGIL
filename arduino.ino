  {"ಹಿಂದೆ", langBmp39, 29, 12},
};
void drawLocalizedText(int x, int baseline, const char* text) {
  if (!text) return;

  // Hindi and Kannada content below the header divider is shifted down 6 px.
  // Header text stays in its original position; English layout is unchanged.
  int adjustedBaseline = baseline;
  if (language != ENGLISH && baseline > 17) {
    adjustedBaseline += 6;
  }

  for (uint16_t i=0; i<sizeof(langBitmaps)/sizeof(langBitmaps[0]); i++) {
    if (strcmp(text, langBitmaps[i].text)==0) {
      int top = adjustedBaseline - langBitmaps[i].height;
      u8g2.drawXBMP(x, top, langBitmaps[i].width, langBitmaps[i].height, langBitmaps[i].bitmap);
      return;
    }
  }
  u8g2.drawStr(x, adjustedBaseline, text); // ASCII fallback; dynamic serial text remains readable
}

